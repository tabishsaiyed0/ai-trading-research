# Redis (local or AWS ElastiCache)
REDIS_URL=redis://localhost:6379
# For AWS ElastiCache / MemoryDB use: rediss://...

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ai-trading-research-data

# Market data (Yahoo primary — no keys; Alpaca secondary)
# Yahoo requires no credentials. Alpaca is optional fallback:
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_DATA_FEED=iex
# S3 OHLCV cache prefix (curated datasets archived as ohlcv/<SYMBOL>/<TF>/YYYY-MM-DD_YYYY-MM-DD.json)
MARKET_DATA_S3_PREFIX=ohlcv

# AWS Bedrock (for NL -> Strategy)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Alternative: amazon.nova-pro-v1:0

# Next
NEXT_PUBLIC_APP_NAME="AI Trading Research"
